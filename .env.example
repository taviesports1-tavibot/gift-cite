# Shared
APP_NAME=ХАОС ПОДАРКОВ
NODE_ENV=production

# Web (Vercel)
NEXT_PUBLIC_APP_NAME=ХАОС ПОДАРКОВ
NEXT_PUBLIC_APP_URL=https://gift-chaos.vercel.app
NEXT_PUBLIC_REALTIME_URL=https://gift-chaos-realtime.example.com
REALTIME_SERVER_URL=https://gift-chaos-realtime.example.com
REALTIME_ADMIN_TOKEN=replace-with-long-random-secret
ADMIN_PASSWORD=replace-with-strong-password
AUTH_SECRET=replace-with-at-least-32-random-bytes

# Realtime service (Railway / Render / Fly.io)
PORT=8080
WEB_ORIGIN=https://gift-chaos.vercel.app
DATABASE_URL=postgresql://user:password@host:5432/giftchaos?sslmode=require
TIKTOK_PROVIDER=demo
TIKTOK_SESSION_ID=
TIKTOK_TT_TARGET_IDC=
LOG_LEVEL=info
